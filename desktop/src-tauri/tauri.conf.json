{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ganjoorak",
  "version": "0.1.3",
  "identifier": "net.ganjoorak.app",
  "build": {
    "beforeDevCommand": "npm run dev --prefix ..",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run prepare:next",
    "frontendDist": "../dist-shell"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "گنجورک",
        "width": 430,
        "height": 860,
        "minWidth": 360,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' http://127.0.0.1:* http://localhost:* https: data: blob: 'unsafe-inline' 'unsafe-eval'; connect-src 'self' http://127.0.0.1:* http://localhost:* https: data: blob:; media-src 'self' http://127.0.0.1:* http://localhost:* https: data: blob:; img-src 'self' http://127.0.0.1:* http://localhost:* https: data: blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/node"],
    "resources": ["next-standalone"]
  }
}
